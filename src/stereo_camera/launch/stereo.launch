<launch>
  <arg name="video_device" default="/dev/video0"/>
  <arg name="width" default="3840"/>
  <arg name="height" default="1080"/>
  <arg name="fps" default="30"/>
  <!-- 降采样输出分辨率（单幅）。launch 默认降到 640x480 发布；
       需要全分辨率 1920x1080 时设 out_width:=1920 out_height:=1080，
       或 out_width:=0 关闭缩放。 -->
  <arg name="out_width" default="640"/>
  <arg name="out_height" default="480"/>

  <node pkg="stereo_camera" type="stereo_node.py" name="stereo_camera" output="screen">
    <param name="video_device" value="$(arg video_device)"/>
    <param name="width" value="$(arg width)"/>
    <param name="height" value="$(arg height)"/>
    <param name="fps" value="$(arg fps)"/>
    <param name="out_width" value="$(arg out_width)"/>
    <param name="out_height" value="$(arg out_height)"/>
  </node>
</launch>
